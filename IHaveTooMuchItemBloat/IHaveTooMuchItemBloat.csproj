<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>IHaveTooMuchItemBloat</AssemblyName>
        <RootNamespace>IHaveTooMuchItemBloat</RootNamespace>
        <ThunderstorePackageName>I_Have_Too_Much_Item_Bloat</ThunderstorePackageName>
        <Author>Delfofthebla</Author>
        <Version>1.0.0</Version>
        <PluginVersionSource>IHaveTooMuchItemBloatPlugin.cs</PluginVersionSource>
        <!-- R2API depends on MMHOOK.RoR2, which only ships .NET Framework builds; this mod never references it. -->
        <NoWarn>$(NoWarn);NU1701</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3"/>
        <PackageReference Include="BepInEx.Core" Version="5.4.21"/>
        <PackageReference Include="RiskOfRain2.GameLibs" Version="1.5.0-r.1" Publicize="true"/>
        <PackageReference Include="UnityEngine.Modules" Version="2021.3.45" IncludeAssets="compile"/>
        <PackageReference Include="R2API.Core" Version="5.3.0"/>
        <PackageReference Include="R2API.Language" Version="1.1.0"/>
        <PackageReference Include="R2API.Prefab" Version="1.1.1"/>
        <PackageReference Include="R2API.Director" Version="3.1.2"/>
        <PackageReference Include="Rune580.Mods.RiskOfRain2.RiskOfOptions" Version="2.8.6"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="ProperSave" HintPath="$(ProfilePluginsDir)\KingEnderBrine-ProperSave\ProperSave\ProperSave.dll"/>
    </ItemGroup>
</Project>
